# Copie para .env e preencha.  ->  cp .env.example .env
#
# Ou deixe o assistente preencher sozinho:  python run.py --setup
#
# O .env está no .gitignore. Nunca comite o token.

# --- Telegram -----------------------------------------------------------
# Token: fale com o @BotFather no Telegram -> /newbot
TELEGRAM_BOT_TOKEN=""
# Chat id: `python run.py --setup` descobre sozinho depois que você mandar
# qualquer mensagem pro seu bot.
TELEGRAM_CHAT_ID=""

# Hora local (0-23) e minuto (0-59) do resumo diário.
RESUMO_DIARIO_HORA="23"
RESUMO_DIARIO_MINUTO="59"
# Quanto tempo depois do alvo o resumo ainda pode sair — inclusive já passada a
# meia-noite, contando como o relatório do dia que fechou.
#
# O disparo não é um agendador: só roda no fim de cada ciclo, e o ciclo leva
# ~100s + BETANO_POLL_INTERVAL de sono (~4,6 min entre checagens). Com alvo
# perto da meia-noite a janela até o dia virar é menor que isso, então sem
# tolerância o relatório quase nunca sairia. Também tem que ser bem menor que
# 24h, senão subir o bot ao meio-dia dispararia o resumo de ontem na hora.
RESUMO_TOLERANCIA_MINUTOS="30"

# --- Liquidação (a aposta deu green ou red?) -----------------------------
# O resumo diário lista as apostas cujo JOGO terminou nas últimas 24h, com
# ✅/❌ e o saldo em unidades. O resultado vem do SofaScore.
#
# A liquidação roda incremental, algumas partidas por ciclo, e grava. O
# relatório das 23:59 só lê o banco: um lote de rede naquele horário seria
# ~5 min de bloqueio no exato momento em que falhar é irrecuperável (o resumo
# se marca como enviado mesmo quando o envio falha, pra não virar loop).
#
# Cada partida custa ~8 requests (~5s com o rate limit do SofaScore).
LIQUIDACAO_MAX_POR_CICLO="3"
# Quanto esperar depois do apito inicial pra tentar liquidar: 90 de jogo +
# intervalo + acréscimos + margem pro SofaScore fechar a estatística.
LIQUIDACAO_ATRASO_MIN="150"
# Depois de N tentativas sem casar, a partida é estacionada de vez. Sem isso
# um jogo que nunca casa volta pra fila a cada ciclo pra sempre.
LIQUIDACAO_MAX_TENTATIVAS="6"
# Combo com uma perna PERDIDA e outra não resolvível: conta como red (1) ou
# como desconhecido (0)?
#
# Padrão 1 porque combo quase sempre casa perna de gol resolvível com perna
# exótica (escanteio, cartão), e `red` continua exigindo uma perna CONFIRMADA
# perdida — nunca inferida. Perna não resolvível SOZINHA nunca vira derrota
# nos dois modos.
LIQUIDACAO_RED_COM_PERNA_INDEFINIDA="1"
# Avisar no chat quando o detector de quebra do scraper disparar.
ALERTAR_QUEBRA="1"

# --- Casas monitoradas --------------------------------------------------
# Ligar/desligar em bloco as casas da plataforma Altenar (nome antigo:
# ENABLE_ESPORTIVA, ainda aceito). A Betano é independente disto.
ENABLE_ALTENAR="1"
# Quais casas Altenar usar, por slug, separadas por vírgula. Vazio = todas as
# 10 mapeadas. A lista completa está em config.CASAS_ALTENAR e em
# CASAS-MAPEADAS.md. Ex: CASAS_ALTENAR="esportiva,estrelabet,4play,betgorillas"
#
# Dica de calibragem: MultiBet, BetPix365, JogoDeOuro e VaiDeBet têm a API
# aberta mas não tinham boost no ar quando foram medidas — elas gastam
# orçamento de request sem devolver oferta. Se quiser economizar, tire-as daqui
# (e volte a olhar de vez em quando: promoção vai e vem).
CASAS_ALTENAR=""
# Quantas casas Altenar raspar por ciclo (rodízio). 0 = todas de uma vez.
# Com 10 casas e 3 por ciclo, cada casa é visitada a cada 4 ciclos (~12 min).
CASAS_POR_CICLO="3"
# Eventos por casa que ganham request de detalhe (onde estão os combos e a odd
# original). O custo do ciclo é este número x CASAS_POR_CICLO.
ALTENAR_MAX_DETALHES="12"
# Até que profundidade da listagem procurar combos. Cada visita sonda uma fatia
# diferente e vai dando a volta, porque o boost nem sempre está no topo: na
# VaiDeBet os combos só começam no 20º jogo, e sondar sempre os 12 primeiros
# fazia ela devolver ZERO oferta. Com 48/12, a casa cobre a janela em 4 visitas.
ALTENAR_JANELA_SONDA="48"
# Até quantas horas à frente vale gastar request de detalhe. O orçamento é
# pequeno e a casa só volta a cada ~12 min: sondar jogo de daqui a três dias
# (ou um que já começou) rouba a vez do jogo desta tarde.
ALTENAR_HORIZONTE_HORAS="24"

# --- Ritmo do scraping --------------------------------------------------
# Segundos entre ciclos. Não baixe sem necessidade: o WAF escala a resposta ao
# volume. Com 3 casas por ciclo o ciclo leva ~100s, então 180s tem folga, mas
# não muita: aumentar CASAS_POR_CICLO ou ALTENAR_MAX_DETALHES pede subir isto.
BETANO_POLL_INTERVAL="180"
# Teto de ofertas avaliadas por ciclo (cada uma custa ~2 requests na Pinnacle).
# O que não couber continua na fila e entra nos ciclos seguintes.
MAX_AVALIACOES_POR_CICLO="60"
# Quando uma oferta parada volta pra fila. A odd da Betano pode ficar parada
# enquanto a linha da Pinnacle anda — é aí que o edge nasce. 0 = avaliar cada
# versão uma única vez.
REAVALIAR_APOS_MINUTOS="60"
# Janela de kickoff que a fila prioriza. A Pinnacle publica mercado perto do
# jogo (67% entre 3 e 12h, 3% acima de 48h), então é aí que a avaliação tem
# chance de virar alerta. Jogo fora da janela continua na fila, mas atrás.
HORIZONTE_AVALIACAO_HORAS="12"
# TTL de reavaliação pra quem está fora da janela acima. Reavaliar de hora em
# hora um jogo de amanhã é pagar Pinnacle pra ouvir o mesmo "sem mercado".
REAVALIAR_LONGE_MINUTOS="240"
# Teto de mensagens por ciclo.
MAX_ALERTAS_POR_CICLO="10"
# Piso entre dois alertas da MESMA oferta, em minutos. Uma oferta só alerta
# de novo se o edge melhorou o suficiente (ver REALERTA_MELHORA_MIN_PP) E já
# se passou esse tempo desde o último envio.
INTERVALO_MIN_REALERTA="30"
# Quantos pontos percentuais de edge a oferta precisa ganhar sobre o MELHOR
# edge já alertado pra justificar um segundo envio da mesma oferta.
REALERTA_MELHORA_MIN_PP="5.0"
# Teto de quantos alertas a MESMA oferta pode gerar, mesmo com melhora
# repetida de edge.
MAX_REALERTAS_POR_OFERTA="2"
# Idade máxima da captura (minutos) pra virar alerta quando a revalidação não
# conseguiu confirmar a odd. O rodízio de casas × rodízio da janela de detalhes
# deixa uma oferta até ~1h sem refresh.
IDADE_MAX_PARA_ALERTA="20"
# Abaixo de quantos minutos pro kickoff o alerta sai MARCADO "em cima da hora".
# Não é corte: a oferta ainda é enviada. Jogo já iniciado é que não sai nunca.
MIN_ANTECEDENCIA_ALERTA="15"
# Quanto a odd revalidada pode divergir da guardada. 0 = tem que ser igual.
TOLERANCIA_REVALIDACAO="0.0"
# Acima deste ganho (%) o alerta manda conferir o limite de aposta no site.
# A API da Altenar não publica esse teto, e boost desproporcional (1.29 -> 12.00)
# quase sempre tem um — senão "apostar 5un" vira recomendação inexecutável.
BOOST_ALTO_AVISO_PCT="100"

# --- Value bet ----------------------------------------------------------
# Edge mínimo pra alertar, em %.
EDGE_MIN_SIMPLES="5.0"
# Combo é mais alto porque a odd justa assume pernas independentes e sai
# otimista. Ver a nota em value/fair_odds.py.
EDGE_MIN_COMBO="18.0"
# Teto da odd JUSTA em mercado simples — acima disso não alerta, por mais edge
# que tenha. Corta "melhor time do mundo x time do bairro, aposte no bairro"
# sem barrar odd ofertada alta: justa 4.80 com ofertada 7.00 continua passando.
# Não vale pra combo. 0 desliga.
ODD_JUSTA_MAX="5.0"
# Estimar a linha quando a Pinnacle publica as vizinhas mas não a exata.
# 0 desliga e o avaliador só usa preço observado.
INTERPOLAR_LINHAS="1"

# --- Consenso entre casas ------------------------------------------------
# A Pinnacle não publica prop de jogador (chutes ao gol, cartões, artilheiro).
# Nesses mercados a referência é a mediana de-vigada das outras casas.
#
# Baixado de 20.0 para 8.0 e CONSENSO_MIN_CASAS subido de 3 para 5 em
# 2026-08-06 — decisão do dono, risco na mesa: a tabela de confiança por tipo
# de mercado (skill `value-bet-methodology`) agora segura o risco por outra
# via (tier de confiança `média`/`baixa` nunca `alta`, Kelly ⅛ em vez de ¼,
# EDGE_MIN_PROP/EDGE_MIN_COMBO_CONSENSO=30 pros mercados mais finos). Ver o
# comentário completo em value/config.py.
EDGE_MIN_CONSENSO="8.0"
# Combo com alguma perna em consenso (sem Pinnacle). Ver value/config.py.
EDGE_MIN_COMBO_CONSENSO="30.0"
# Cartão, chute ao gol, artilheiro (gol de jogador) e handicap sem Pinnacle —
# a classe mais fraca da tabela. Ver value/config.py.
EDGE_MIN_PROP="30.0"
# Mínimo de casas pra formar consenso. Duas não são consenso, são desempate.
CONSENSO_MIN_CASAS="5"
# Mínimo de casas pra cartão/chute ao gol/artilheiro/handicap — mais alto que
# o consenso genérico. Ver value/config.py.
CONSENSO_MIN_CASAS_PROP="6"
# Janela de frescor do preço das outras casas, em horas. Existe por causa do
# rodízio (CASAS_POR_CICLO): sem ela quase nunca haveria casas no mesmo ciclo.
CONSENSO_JANELA_HORAS="3.0"
# Quanto tempo guardar mercado de casa antes de podar.
CONSENSO_RETENCAO_HORAS="12.0"
# Acima deste edge o alerta sai com selo de suspeito — marcado, não suprimido.
EDGE_SUSPEITO_PCT="100.0"
# Teto de sanidade: acima disto em QUALQUER mercado o edge é bloqueado
# (flag="possivel_erro_matching"), não só marcado. Ver value/config.py.
EDGE_TETO_SANIDADE="50.0"

# --- Modelo de placar ---------------------------------------------------
# A Pinnacle publica placar exato / HT/FT / gols exatos em só ~1 de cada 12
# jogos. Nos outros o modelo deriva isso do 1X2 + over/under.
#
# NASCE DESLIGADO. Com 0 o modelo calcula, loga e grava — mas não alerta.
# Antes de ligar, rode `python avaliar.py --calibrar-modelo` e olhe o p90:
# na medição de 2026-08-04 o erro do modelo no placar exato tinha p90 de 32%,
# ou seja, quase todo "value" abaixo disso seria ruído do próprio ajuste.
MODELO_ALERTA_ATIVO="0"
# Edge mínimo pra odd derivada. Tem que ficar ACIMA do p90 do erro medido.
EDGE_MIN_MODELO="35.0"
# Correção de Dixon-Coles nos placares baixos. Não é ajustada por jogo.
MODELO_RHO="-0.05"
# Resíduo máximo do ajuste pra CRIAR uma odd justa.
MODELO_ERRO_MAX="0.0004"
# Resíduo máximo pra CORRIGIR a conjunta de um combo — mais folgado de
# propósito: essa correção só REDUZ uma probabilidade já superestimada pela
# multiplicação por independência, então erra pro lado seguro.
MODELO_ERRO_MAX_CORRELACAO="0.002"

# --- Estatística do SofaScore (segunda camada) ---------------------------
# Histórico de placar + desfalques, POR CIMA do edge de odds — nunca no lugar
# dele. Só roda em oferta que já passou no filtro de confiança, e o efeito é
# de mão única: rebaixa a confiança um degrau, nunca sobe. Não recalcula edge
# nem stake, então não consegue inventar value bet.
#
# Custo medido em 2026-08-06 (40 ofertas, cache frio): +7s no lote inteiro.
# É barato porque só ~15% das ofertas chegam no passo que dispara a camada.
STATS_SOFASCORE_ATIVO="1"
# Pausa mínima entre requests no SofaScore. O host manda `max-age=60` e há
# cache em sqlite (tabela sofascore_cache), então o volume real é bem menor.
SOFASCORE_MIN_INTERVALO_S="0.4"

# --- Stake (quanto apostar) ---------------------------------------------
# 1 unidade = quantos % da banca. Quanto vale em dinheiro é decisão sua.
UNIDADE_PCT_BANCA="1.0"
# Fração de Kelly. Kelly cheio (1.0) só é ótimo se a probabilidade estiver
# CERTA — e a nossa é estimada. 0.25 é o padrão de mercado. Subir isto aumenta
# o risco de ruína bem mais rápido do que aumenta o retorno.
KELLY_FRACAO="0.25"
# Teto por aposta, em unidades. Kelly em odd baixa com edge alto pede fração
# absurda da banca (1.21 contra 1.12 justa = 38%).
STAKE_MAX_UNIDADES="5.0"
# Abaixo disto o alerta diz "não vale a pena".
STAKE_MIN_UNIDADES="0.25"
# Granularidade (sempre arredonda pra baixo).
STAKE_PASSO="0.25"
# Descontos onde a odd justa é sabidamente otimista.
STAKE_DESCONTO_COMBO="0.5"
STAKE_DESCONTO_INTERPOLADA="0.75"
# Odd derivada do modelo de placar: não foi observada em preço nenhum.
STAKE_DESCONTO_MODELO="0.4"
